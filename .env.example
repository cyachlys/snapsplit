# ========================================================
# SplitWoi! / SnapSplit Environment Configuration
# ========================================================

# [REQUIRED FOR VERCEL] Cloud Database: Turso (LibSQL SQLite)
# Create a free database at https://turso.tech
TURSO_DATABASE_URL=libsql://your-database-name-username.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# [OPTIONAL] Admin Vault Security Key (Default: splitwoi#admin)
ADMIN_KEY=splitwoi#admin

# [OCR STANDARD] RapidAPI Hub - Receipt and Invoice OCR API
RAPIDAPI_KEY=18c4b2fd16msh32d393319e95b02p1ebdb6jsncda25d8eb8d3
RAPIDAPI_HOST=receipt-and-invoice-ocr-api.p.rapidapi.com

# [OPTIONAL] Anthropic API Key for Receipt AI Scanning (fallback)
# If omitted, manual item entry is used.
ANTHROPIC_API_KEY=sk-ant-api03-...

# [LOCAL ONLY] Local Port
PORT=3000
